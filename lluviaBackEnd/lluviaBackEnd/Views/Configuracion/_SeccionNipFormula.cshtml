<div class="card">
    <div class="card-header">
        <h4>NIP de fórmula de producción</h4>
    </div>
    <div class="card-body">
        <p class="text-muted">NIP compartido que piden las handhelds para ver la fórmula. Al cambiarlo se desbloquea a todos los usuarios.</p>
        <form id="frmNipFormula" autocomplete="off">
            <div class="form-group">
                <label for="txtNipNuevo">Nuevo NIP (4 dígitos)</label>
                <div class="input-group">
                    <input type="password" id="txtNipNuevo" class="form-control solo-digitos" maxlength="4" inputmode="numeric" autocomplete="new-password" />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-outline-secondary btn-ver-nip" data-target="#txtNipNuevo" tabindex="-1" title="Mostrar NIP"><i class="fas fa-eye"></i></button>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label for="txtNipConfirmacion">Confirmar NIP</label>
                <div class="input-group">
                    <input type="password" id="txtNipConfirmacion" class="form-control solo-digitos" maxlength="4" inputmode="numeric" autocomplete="new-password" />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-outline-secondary btn-ver-nip" data-target="#txtNipConfirmacion" tabindex="-1" title="Mostrar NIP"><i class="fas fa-eye"></i></button>
                    </div>
                </div>
            </div>
            <div class="text-right">
                <button type="submit" id="btnCambiarNipFormula" class="btn btn-success">Cambiar NIP</button>
            </div>
        </form>
    </div>
</div>
