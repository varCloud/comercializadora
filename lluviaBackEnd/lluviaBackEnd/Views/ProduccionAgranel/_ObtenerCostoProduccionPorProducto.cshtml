@using System.Globalization;
@using lluviaBackEnd.Models;

@model Notificacion<List<CostoProduccionAgranelPorProducto>>

@if (Model.Estatus != 200)
{

    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-info"></i>
        </div>
        <h2>@Model.Mensaje</h2>
    </div>

}
else
{
    <div class="table-responsive">
        <table class="table table-striped" id="tblMPLIndividual">
            <thead>
                <tr>
                    <th>Codigo de Barras</th>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Cantidad Aceptada</th>
                    <th>Cantidad Restante</th>
                    <th>Fecha Alta</th>
                    <th>Ultima Actualizacion</th>
                    <th>Estatus</th>
                    <th>Ultimo Costo de Compra</th>
                    <th>Costo de Producción</th>
                </tr>
            </thead>
            <tbody>

                @foreach (lluviaBackEnd.Models.CostoProduccionAgranelPorProducto c in Model.Modelo)
                {
                <tr>
                    <td>@c.codigoBarras</td>
                    <td>@c.descripcionProducto</td>
                    <td>@c.cantidad</td>
                    <td>@c.cantidadAceptada</td>
                    <td>@c.cantidadRestante</td>
                    <td>@c.fechaAlta.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@c.fechaUltimaActualizacion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@c.descripcionEstatus</td>
                    <td>@c.ultimoCostoCompra.ToString("C", new CultureInfo("en-US"))</td>
                    <td>@c.costoProduccion.ToString("C", new CultureInfo("en-US"))</td>
                </tr>
                }
            </tbody>
        </table>
    </div>

}
